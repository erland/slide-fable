{
  "name": "slide-fable",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src vite.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:editor": "node tests/editor-browser.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "dompurify": "3.4.17",
    "html-to-image": "1.11.13",
    "jszip": "3.10.1",
    "katex": "0.19.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
