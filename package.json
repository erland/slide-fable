{
  "name": "slide-fable",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src vite.config.ts",
    "test": "node scripts/run-tests-with-browser.cjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:text-overflow": "node tests/text-overflow-browser.mjs",
    "test:text-export": "node tests/text-export-parity-browser.mjs",
    "test:lifecycle": "node tests/lifecycle-browser.mjs",
    "profile:history": "node --experimental-strip-types scripts/profile-history.mjs",
    "test:common-workflows": "node tests/common-workflows-browser.mjs",
    "test:external-transfer": "node tests/external-transfer-browser.mjs",
    "test:native-icons": "node tests/native-icons-pptx-browser.mjs",
    "test:animation-stability": "node tests/animation-stability-browser.mjs",
    "test:raw": "npm run test:animation-stability && npm run test:native-icons && npm run test:external-transfer && npm run test:data-ribbon && npm run test:export-advanced && node --experimental-strip-types --test tests/*.test.mjs && npm run test:lifecycle && npm run test:pwa && npm run test:inline-ux && npm run test:insert-gallery && npm run test:design-ribbon && npm run test:background-ribbon && npm run test:start-format && npm run test:text-fit-ribbon && npm run test:document-file && npm run test:motion-ribbon && npm run test:master-layout && npm run test:export-geometry && npm run test:export-data && npm run test:table-split && npm run test:panel-workflow",
    "test:inline-ux": "node tests/inline-text-browser.mjs",
    "test:insert-gallery": "node tests/insert-gallery-browser.mjs",
    "test:design-ribbon": "node tests/design-ribbon-browser.mjs",
    "test:background-ribbon": "node tests/background-ribbon-browser.mjs",
    "test:start-format": "node tests/start-format-browser.mjs",
    "test:text-fit-ribbon": "node tests/text-fit-ribbon-browser.mjs",
    "test:document-file": "node tests/document-file-browser.mjs",
    "test:data-ribbon": "node tests/data-ribbon-browser.mjs",
    "test:motion-ribbon": "node tests/motion-ribbon-browser.mjs",
    "test:master-layout": "node tests/master-layout-browser.mjs",
    "test:export-geometry": "node tests/export-geometry-parity-browser.mjs",
    "test:export-data": "node tests/export-data-parity-browser.mjs",
    "test:export-advanced": "node tests/export-advanced-data-browser.mjs",
    "test:table-split": "node tests/table-split-browser.mjs",
    "test:panel-workflow": "node tests/panel-workflow-browser.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "dompurify": "3.4.17",
    "html-to-image": "1.11.13",
    "jszip": "3.10.1",
    "katex": "0.19.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
