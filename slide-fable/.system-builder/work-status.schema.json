{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "phase", "planning", "implementation", "selected_step", "in_progress", "next", "blocking_issues", "validation", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"type": "string"},
    "planning": {"enum": ["complete", "in_progress"]},
    "implementation": {"enum": ["not_started", "in_progress", "complete"]},
    "selected_step": {"type": ["string", "null"]},
    "in_progress": {"type": ["string", "null"]},
    "next": {"type": "object", "required": ["recommended", "title"], "properties": {"recommended": {"type": ["string", "null"]}, "title": {"type": "string"}}},
    "blocking_issues": {"type": "array"},
    "validation": {"type": "object", "required": ["last_result", "scope", "evidence"]},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "dependencies", "status"], "properties": {"id": {"type": "string", "pattern": "^DEV-[0-9]{3}$"}, "title": {"type": "string"}, "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "status": {"enum": ["planned", "in_progress", "completed", "blocked"]}}}}
  }
}
